# Faster-Whisper local speech-to-text. The model downloads on first use.
ACE_STT_MODEL=small
ACE_STT_DEVICE=cpu
ACE_STT_COMPUTE_TYPE=int8
ACE_STT_LANGUAGE=

# NVIDIA OpenAI-compatible chat completions API.
ACE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
ACE_NVIDIA_API_KEY=replace-me
ACE_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ElevenLabs streaming text-to-speech.
ACE_ELEVENLABS_API_KEY=replace-me
ACE_ELEVENLABS_VOICE_ID=replace-me
ACE_ELEVENLABS_MODEL=eleven_turbo_v2_5

ACE_AUDIO_SAMPLE_RATE=16000
ACE_LOG_PATH=logs/sessions.jsonl
